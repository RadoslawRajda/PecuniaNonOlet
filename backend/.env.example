# Generate a new 32-byte key with the command in README.md, then paste it here.
# Keep the actual .env file private and never commit it.
MFA_ENCRYPTION_KEY=
# Cloudflare Turnstile test secret for local development only; replace for production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional: enforce the hostname returned by Turnstile, e.g. app.example.com.
TURNSTILE_EXPECTED_HOSTNAME=

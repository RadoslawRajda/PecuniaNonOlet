# Generate a new 32-byte key with the command in README.md, then paste it here.
# Keep the actual .env file private and never commit it.
MFA_ENCRYPTION_KEY=
# Cloudflare Turnstile test secret for local development only; replace for production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional: enforce the hostname returned by Turnstile, e.g. app.example.com.
TURNSTILE_EXPECTED_HOSTNAME=

# Google OAuth client IDs from the same Google Cloud project (iOS and Android IDs).
# The backend verifies the ID token signature, issuer, expiry, audience and nonce.
GOOGLE_OAUTH_CLIENT_IDS=ios-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com

# Passkeys: .local is for trusted LAN development only.
WEBAUTHN_RP_ID=pecunianonolet.local
WEBAUTHN_ALLOWED_ORIGINS=https://pecunianonolet.local,https://pecunianonolet.local:8000,android:apk-key-hash:-sYXRdwJA3hvue3mKpYrOZ9zSPC7b4mbgzJmdZEDO5w
APPLE_TEAM_ID=96UM85TJJ7
IOS_BUNDLE_ID=com.rajda.pecunianonolet
ANDROID_PACKAGE_NAME=com.pecunianonolet
# SHA-256 fingerprints for the signing certificates used by installed debug/release APKs.
ANDROID_SHA256_CERT_FINGERPRINTS=FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C

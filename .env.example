API_URL=https://pecunianonolet.local:8000
# Cloudflare Turnstile development test key. Replace with your own site key for production.
TURNSTILE_SITE_KEY=3x00000000000000000000FF
# Google OAuth public client IDs from one Google Cloud project. Set the same IDs in backend/.env.
GOOGLE_IOS_CLIENT_ID=ios-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=android-client-id.apps.googleusercontent.com
